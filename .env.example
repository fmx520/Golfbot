# ForeUp credentials
FOREUP_USERNAME=your_foreup_email@example.com
FOREUP_PASSWORD=your_foreup_password
FOREUP_BASE_URL=https://foreupsoftware.com

# Default course identifiers (override per-job via UI or CLI)
FOREUP_SCHEDULE_ID=
FOREUP_COURSE_ID=

# Playwright fallback
PLAYWRIGHT_HEADLESS=true

# Sniper timing. The pre-release re-warm is a login round trip against ForeUp at
# its busiest moment; if it overruns the release we start polling late and lose
# the race before it begins. Raise this if race logs report "late_start".
SNIPER_PREWARM_LEAD_SECONDS=12

# Race telemetry. Every sniper race writes one record. Without a durable sink
# the only copies are stdout and logs/races.jsonl — neither survives a Render
# deploy, restart, or free-plan spin-down, so cross-race history needs one of
# the two sinks below. Both are optional and can run at the same time.
GOLFBOT_LOG_DIR=logs

# Sink A — the repo itself. No extra service to sign up for. Writes one file per
# race to race-logs/YYYY/MM/ on a side branch, created automatically. The branch
# must NOT be the one Render deploys from, or every race would redeploy the app.
# Token: a fine-grained PAT with Contents: Read and write on this repo only.
RACE_LOG_GITHUB_REPO=fmx520/Golfbot
RACE_LOG_GITHUB_TOKEN=
RACE_LOG_GITHUB_BRANCH=race-logs

# Sink B — any endpoint that accepts a JSON POST (Supabase, a Cloud Function).
# See supabase/schema.sql for the table definition.
RACE_LOG_WEBHOOK_URL=
# Shorthand for a bearer token:
RACE_LOG_WEBHOOK_TOKEN=
# Or a JSON object when the backend needs several headers, e.g. Supabase:
# RACE_LOG_WEBHOOK_HEADERS={"apikey":"SERVICE_KEY","Authorization":"Bearer SERVICE_KEY","Prefer":"return=minimal"}
RACE_LOG_WEBHOOK_HEADERS=

# Optional notification
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
