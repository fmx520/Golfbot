# ForeUp credentials
FOREUP_USERNAME=your_foreup_email@example.com
FOREUP_PASSWORD=your_foreup_password
FOREUP_BASE_URL=https://foreupsoftware.com

# Default course identifiers (override per-job via UI or CLI)
FOREUP_SCHEDULE_ID=
FOREUP_COURSE_ID=

# Playwright fallback
PLAYWRIGHT_HEADLESS=true

# Optional notification
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
